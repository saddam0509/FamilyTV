<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Family TV" android:banner="@drawable/family_launcher_banner"
        android:icon="@drawable/family_launcher_icon"
        android:allowBackup="false" android:networkSecurityConfig="@xml/network_security"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:banner="@drawable/family_launcher_banner" android:icon="@drawable/family_launcher_icon"
            android:enableOnBackInvokedCallback="false" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
